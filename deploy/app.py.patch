+async def _read_json_post(request, session):
+    """Session-only JSON POST: exact content type, one valid CSRF header, bounded body."""
+    if session is None or not session.authenticated or request.state.proxy_trusted:
+        return 403, None
+    if request.headers.get('content-type', '').split(';', 1)[0].strip().lower() != 'application/json':
+        return 415, None
+    header_values = request.headers.getlist('x-csrf-token')
+    if len(header_values) != 1 or not auth.csrf_matches(session.csrf, header_values[0]):
+        return 403, None
+    body = bytearray()
+    async for chunk in request.stream():
+        body.extend(chunk)
+        if len(body) > JSON_POST_LIMIT:
+            return 413, None
+    return None, bytes(body)
