+def _increment_context(db, ctx, after, now, settle_seconds, matrix):
+    # Source fingerprints and the reviewed epoch live in a separate private DB.
+    # No bodies or raw identities are copied into this ledger.
+    if type(after) is not int or after <= 0:
+        raise ValueError('recovery_boundary_invalid')
+    epoch = kb_model_runtime.sha(kb_model_runtime.canon({
+        'after': after, 'isolation_sha256': matrix.manifest_sha256}))
+    selected = set()
+    snapshots = {}
+    with closing(private_store.open_private_db(RECOVERY_DB)) as recovery:
+        recovery.execute('PRAGMA synchronous=FULL')
+        recovery.execute('BEGIN IMMEDIATE')
+        try:
+            recovery.execute('CREATE TABLE IF NOT EXISTS recovery_epoch (key TEXT PRIMARY KEY, digest TEXT NOT NULL)')
+            recovery.execute('CREATE TABLE IF NOT EXISTS recovery_sources (source_key TEXT PRIMARY KEY, fingerprint TEXT NOT NULL)')
+            previous = recovery.execute("SELECT digest FROM recovery_epoch WHERE key='cutover'").fetchone()
+            if previous is not None and previous[0] != epoch:
+                raise ValueError('recovery_boundary_changed')
+            recovery.execute("INSERT OR IGNORE INTO recovery_epoch VALUES('cutover', ?)", (epoch,))
+            for row in kb_authorized(db, ctx):
+                role = 'learning' if row['chatroom_id'] in ctx.get('_learning', {}) else 'supplier'
+                source_key = kb_model_runtime.sha(row['evidence_id'])
+                fingerprint = kb_model_runtime.sha(kb_model_runtime.canon({
+                    key: row[key] for key in ('evidence_id', 'chatroom_id', 'body_text',
+                    'price_kind', 'source_created_at', 'received_at', 'created_at',
+                    'source_kind', 'source_sha256', 'classification_id', 'owner', 'source_scope')
+                }) + '\0' + role)
+                old = recovery.execute('SELECT fingerprint FROM recovery_sources WHERE source_key=?', (source_key,)).fetchone()
+                if old is not None and old[0] != fingerprint:
+                    raise ValueError('live_evidence_changed')
+                # Missing original send time is not proof of natural arrival.
+                if row['source_created_at'] is None or row['created_at'] is None:
+                    continue
+                source_at = _seconds(row['source_created_at'])
+                admitted_at = _seconds(row['created_at'])
+                if source_at <= after or admitted_at <= after or row['price_kind'] == 'customer_inquiry' or row['source_kind'] == 'historical_message':
+                    continue
+                recovery.execute('INSERT OR IGNORE INTO recovery_sources VALUES(?, ?)', (source_key, fingerprint))
+                # Settle per evidence, so a busy room cannot starve older arrivals.
+                if now - max(source_at, admitted_at) >= settle_seconds:
+                    selected.add(row['evidence_id'])
+                    snapshots[row['evidence_id']] = dict(row)
+            recovery.commit()
+        except BaseException:
+            recovery.rollback()
+            raise
+    return {**ctx, '_kb_live_ids': frozenset(selected), '_kb_live_rows': snapshots}
