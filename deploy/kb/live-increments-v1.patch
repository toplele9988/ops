+def read_recovery_boundary(matrix):
+    raw = kb_model_runtime.restricted(RECOVERY_BOUNDARY, owner=0)
+    pinned = kb_model_runtime.sha(raw)
+    value = json.loads(raw)
+    if (pinned != RECOVERY_BOUNDARY_SHA256
+            or set(value) != {'schema', 'after', 'isolation_sha256'}
+            or value['schema'] != 'wechat-kb-live-recovery-v1'
+            or type(value['after']) is not int or value['after'] <= 0
+            or value['after'] > time.time()
+            or value['isolation_sha256'] != matrix.manifest_sha256):
+        raise kb_model_runtime.ModelError('kb_model_policy_invalid')
+    matrix.recovery_boundary_sha256 = pinned
+    return value['after']
+
