+                    while remaining:
+                        _require(time.monotonic() < deadline, 'attachment_upload_timeout', 408)
+                        chunk = read(min(65536, remaining))
+                        _require(isinstance(chunk, bytes) and 0 < len(chunk) <= remaining, 'attachment_incomplete_body')
